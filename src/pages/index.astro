---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';
import Steps from '~/components/widgets/Steps.astro';
import Features2 from '~/components/widgets/Features2.astro';
import peStretchFilmMachine from '~/assets/images/pe-stretch-film-machine.jpg';
import lldpeFourShaftStretchFilmMachine from '~/assets/images/lldpe-four-shaft-stretch-film-machine.jpg';
import lldpeStretchClingFilmMachine from '~/assets/images/lldpe-stretch-cling-film-machine.jpg';

const metadata = {
  title: '惠州市富利源实业有限公司',
  description: '惠州市富利源实业有限公司专注塑料薄膜制造机设备，主要产品包括 PVC 薄膜机、PE 保鲜膜机、拉伸膜机等。',
  ignoreTitleTemplate: true,
};

const productImages = [
  {
    title: 'PE缠绕膜拉伸膜',
    src: peStretchFilmMachine,
  },
  {
    title: 'LLDPE四轴绕组拉伸包裹保膜机',
    src: lldpeFourShaftStretchFilmMachine,
  },
  {
    title: 'LLDPE拉伸/保鲜膜机',
    src: lldpeStretchClingFilmMachine,
  },
];

const productCategories = [
  {
    title: 'PE拉伸膜机/缠绕膜机',
    description: '对应 PE 缠绕膜与拉伸膜整线需求。',
  },
  {
    title: 'PVC保鲜膜机',
    description: '适配 PVC 保鲜膜成品稳定连续生产。',
  },
  {
    title: 'CPE/CPP 流延膜机',
    description: '满足药用包装、医用敷料、日用品等行业要求。',
  },
  {
    title: 'TPU/EVA 流延膜机',
    description: '适配弹性薄膜与鞋材、热熔胶膜等场景。',
  },
  {
    title: '淋膜机',
    description: '用于更多工业薄膜与复合材料应用。',
  },
];

const contacts = [
  {
    title: '联系人',
    description: '易经理 — +86 18819694106<br/>辉经理 — +86 13927374240<br/>刘经理 — +86 13316330286',
    icon: 'tabler:user',
  },
  {
    title: 'WhatsApp',
    description: 'sunny yi — +86 18819694106<br/>Lewin Yi — +86 13927374240<br/>Ella Liu — +86 13316330286',
    icon: 'tabler:brand-whatsapp',
  },
  {
    title: '邮箱',
    description: 'fuliyuan@epemachine.com',
    icon: 'tabler:mail',
  },
  {
    title: '公司地址',
    description: '中国广东省惠州市平潭镇怡发3路',
    icon: 'tabler:map-pin',
  },
  {
    title: '售后服务',
    description: '+86 13680898941',
    icon: 'tabler:headset',
  },
  {
    title: '抖音',
    description: '抖音官方账号',
    icon: 'tabler:brand-tiktok',
  },
];
---

<Layout metadata={metadata}>
  <Hero
    tagline="富利源机械"
    actions={[
      { variant: 'primary', text: '核心产品', href: '#products', icon: 'tabler:tools' },
      { text: '关于我们', href: '#about' },
      { text: '联系我们', href: '#contact' },
    ]}
  >
    <Fragment slot="title">
      流延膜机设备<span class="text-accent dark:text-white">源头厂家</span>
    </Fragment>

    <Fragment slot="subtitle">
      惠州市富利源实业有限公司集产品设计、科研开发、工厂制造、销售与贸易及售后服务于一体，主要产品包括 PVC 薄膜机、PE
      保鲜膜机、拉伸膜机等。
    </Fragment>

    <Fragment slot="image">
      <div class="grid gap-4 md:grid-cols-3">
        {
          productImages.map((product) => (
            <figure class="overflow-hidden rounded-md border border-gray-200 bg-white shadow-sm dark:border-slate-700 dark:bg-slate-900">
              <img
                src={product.src.src}
                alt={product.title}
                loading="eager"
                fetchpriority="high"
                class="h-56 w-full object-cover"
              />
              <figcaption class="px-4 py-3 text-sm font-medium text-gray-900 dark:text-white">
                {product.title}
              </figcaption>
            </figure>
          ))
        }
      </div>
    </Fragment>
  </Hero>

  <Note title="服务承诺：" description="客服热线全天 24 小时开放，首个问题响应时间在 6 小时内。" />

  <Features
    id="advantages"
    tagline="我们的优势"
    title="20 多年薄膜机械生产与处理经验"
    subtitle="公司具备国内外贸易资质，产品销往 60 多个国家，并持续投入研发与服务体系。"
    columns={2}
    items={[
      {
        title: '职业化',
        description:
          '拥有超过 20 年的发泡沫流延膜机械包装机器生产和处理经验；现代化企业，拥有 2 万平方米作坊，集生产、物资收集和贸易服务于一体。',
        icon: 'tabler:building-factory-2',
      },
      {
        title: '创新与研究',
        description:
          '研发团队由 8 名电气和机械工程师组成，技术团队共 23 人；拥有 36 项独立专利，定期举办技术研讨会和讨论。',
        icon: 'tabler:bulb',
      },
      {
        title: '优质产品',
        description:
          '产品种类繁多，机器型号规格齐全；可定制以满足各种生产需求，并集成制造生产系统，节省劳动力并提升效率。',
        icon: 'tabler:settings-cog',
      },
      {
        title: '质量与优质服务',
        description: '持有 CE 和 UL 认证，与知名零部件供应商长期合作；整机提供一年保修，主要部件提供 18 个月保修。',
        icon: 'tabler:certificate',
      },
    ]}
  />

  <section id="products" class="px-4 py-16 sm:px-6 md:py-20">
    <div class="mx-auto max-w-7xl">
      <div class="mx-auto mb-10 max-w-3xl text-center">
        <p class="mb-2 font-bold uppercase tracking-wide text-secondary dark:text-blue-200">核心产品</p>
        <h2 class="font-heading text-4xl font-bold tracking-tighter md:text-5xl dark:text-white">
          核心塑料薄膜制造机产品
        </h2>
        <p class="mt-4 text-xl text-muted dark:text-slate-400">
          FLY 工业专注于高性能塑料薄膜生产设备，核心产品组合涵盖 PVC 保鲜膜机、LLDPE 保鲜膜机和拉伸膜机以及 LLDPE
          四轴拉伸膜机。
        </p>
      </div>
      <div class="grid gap-6 md:grid-cols-3">
        {
          productImages.map((product) => (
            <article class="overflow-hidden rounded-md border border-gray-200 bg-white shadow-sm dark:border-slate-700 dark:bg-slate-900">
              <img src={product.src.src} alt={product.title} loading="lazy" class="h-64 w-full object-cover" />
              <div class="p-5">
                <h3 class="text-xl font-bold dark:text-white">{product.title}</h3>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <Steps
    id="solutions"
    title="从单台设备到交钥匙工程"
    subtitle="20 年专注薄膜制造技术，覆盖配方调试、机械安装、售后全流程，助力客户快速投产。"
    items={[
      {
        title: '01 <span class="font-medium">PVC 保鲜膜流延膜机器生产线</span>',
        description: '包含挤出主机、专用模头、自动收卷，适配 PVC 保鲜膜成品稳定连续生产，满足食品包装与商超领域要求。',
        icon: 'tabler:number-1',
      },
      {
        title: '02 <span class="font-medium">PE 缠绕膜拉伸膜生产线</span>',
        description: '提供 PE 缠绕膜、拉伸膜整线方案，包含挤出主机、模头、自动收卷系统，适配工业包装与物流领域。',
        icon: 'tabler:number-2',
      },
      {
        title: '03 <span class="font-medium">TPU/EVA 流延膜生产线</span>',
        description: '提供流延工艺整线方案，适配弹性薄膜与鞋材、热熔胶膜等下游多种应用场景。',
        icon: 'tabler:number-3',
      },
      {
        title: '04 <span class="font-medium">CPE/CPP 流延膜生产线</span>',
        description: '整线交付，可按成品规格定制，满足药用包装、医用敷料、日用品等行业要求。',
        icon: 'tabler:number-4',
      },
      {
        title: '05 <span class="font-medium">全流程整厂规划服务</span>',
        description: '从配方调试、机械安装到人员培训、售后支持，一站式落地帮客户快速投产。',
        icon: 'tabler:number-5',
      },
    ]}
  />

  <Content
    id="about"
    isReversed
    tagline="关于我们"
    title="惠州市富利源实业有限公司"
    items={[
      { title: '成立时间', description: '公司前身为深圳富利源机械有限公司，成立于 2003 年。' },
      { title: '生产基地', description: '占地面积达 24,000 平方米，位于广东省惠州市惠阳区怡发工业园区。' },
      { title: '交通位置', description: '距离惠州机场 9.2 公里，距离惠州北高速站 29 公里，距离深圳港 100 公里。' },
      { title: '主营产品', description: '主要产品为 PVC 薄膜机、PE 保鲜膜机、拉伸膜机等。' },
    ]}
  >
    <Fragment slot="content">
      <p>
        经过 20
        多年的探索与开发，公司已发展成为现代化塑料薄膜制造机设备企业，集产品设计、科研开发、工厂制造、销售与贸易及售后服务于一体。
      </p>
    </Fragment>
  </Content>

  <Features2
    id="market"
    tagline="供应商与客户"
    title="市场覆盖多个国家和地区"
    subtitle="公司市场覆盖亚洲、中东、非洲、欧亚大陆以及美洲多个国家。"
    columns={3}
    items={[
      {
        title: '亚洲',
        description: '中国、印度、印度尼西亚、越南、泰国、马来西亚、菲律宾、巴基斯坦。',
        icon: 'tabler:world',
      },
      {
        title: '中东与非洲',
        description: '阿拉伯联合酋长国、沙特阿拉伯、伊朗、埃及、摩洛哥、突尼斯、阿尔及利亚、南非、尼日利亚、肯尼亚。',
        icon: 'tabler:world',
      },
      {
        title: '欧亚与美洲',
        description: '土耳其、俄罗斯、巴西、墨西哥、美国、阿根廷、哥伦比亚、智利。',
        icon: 'tabler:world',
      },
    ]}
  />

  <Features2
    id="product-categories"
    tagline="产品分类"
    title="覆盖多类薄膜与包装设备"
    subtitle="按照旧官网信息整理的产品分类，保留企业实际业务范围。"
    columns={3}
    items={productCategories.map((item) => ({
      ...item,
      icon: 'tabler:category',
    }))}
  />

  <Features
    id="patents"
    tagline="创新专利"
    title="核心专利技术与国际认证"
    subtitle="公司拥有多项核心专利技术与国际认证，持续推动产品创新与品质提升。"
    columns={3}
    items={[
      {
        title: '36 项独立专利',
        description: '持续开展研发投入，推动产品技术迭代。',
        icon: 'tabler:award',
      },
      {
        title: 'CE 与 UL 认证',
        description: '公司产品持有 CE 和 UL 认证。',
        icon: 'tabler:shield-check',
      },
      {
        title: '全球 500 强供应商',
        description: '被财富全球 500 强企业指定为包装材料供应商。',
        icon: 'tabler:building-skyscraper',
      },
    ]}
  />

  <section id="contact" class="px-4 py-16 sm:px-6 md:py-20">
    <div class="mx-auto max-w-7xl">
      <div class="mx-auto mb-10 max-w-3xl text-center">
        <p class="mb-2 font-bold uppercase tracking-wide text-secondary dark:text-blue-200">联系我们</p>
        <h2 class="font-heading text-4xl font-bold tracking-tighter md:text-5xl dark:text-white">
          欢迎随时联系我们获取产品报价、技术咨询与售后服务支持
        </h2>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          contacts.map((item) => (
            <article class="rounded-md border border-gray-200 bg-white p-6 shadow-sm dark:border-slate-700 dark:bg-slate-900">
              <h3 class="text-xl font-bold dark:text-white">{item.title}</h3>
              <p class="mt-3 text-muted" set:html={item.description} />
            </article>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
