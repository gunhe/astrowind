---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import FAQs from '~/components/widgets/FAQs.astro';

const metadata = {
  title: '企业官网定制服务 - 品牌官网设计与开发',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    actions={[
      {
        variant: 'primary',
        text: '预约咨询',
        href: '/contact',
        icon: 'tabler:calendar-check',
      },
      { text: '查看服务能力', href: '#features' },
    ]}
    image={{ src: '~/assets/images/hero-image.png', alt: '企业官网定制服务展示' }}
  >
    <Fragment slot="title">
      为企业打造<span class="text-accent dark:text-white">高转化官网</span>
      <span class="hidden xl:inline">，从品牌表达走到业务增长</span>
    </Fragment>

    <Fragment slot="subtitle">
      <span class="hidden sm:inline">
        我们为 B2B 企业、SaaS、制造业和专业服务公司提供官网策划、视觉设计、前端开发、SEO 基础建设与上线维护。</span
      >
      <span class="block mb-1 sm:hidden font-bold text-blue-600">企业官网定制。</span>
      用清晰的信息架构、专业的视觉系统和高性能技术底座，让访问者更快理解你、信任你并联系你。
    </Fragment>
  </Hero>

  <!-- Note Widget ******************* -->

  <Note title="交付原则：" description="业务清晰、设计克制、性能可靠、长期可维护" />

  <!-- Features Widget *************** -->

  <Features
    id="features"
    tagline="服务能力"
    title="我们帮企业把官网做成可持续获客的数字门面"
    subtitle="不只做页面美化，而是从业务定位、内容结构、视觉表达、技术实现到上线运营，完成一套可落地的官网系统。"
    items={[
      {
        title: '官网策略与信息架构',
        description: '梳理目标客户、核心卖点、服务路径和转化动作，让官网先讲清楚“你是谁、解决什么、为什么可信”。',
        icon: 'tabler:sitemap',
      },
      {
        title: '品牌视觉与页面设计',
        description: '基于行业属性和品牌调性设计首页、服务页、案例页、关于页等核心页面，兼顾专业感和可读性。',
        icon: 'tabler:palette',
      },
      {
        title: '高性能前端开发',
        description: '使用 Astro、Tailwind CSS 和静态化架构构建快速、稳定、易维护的网站，适合长期运营和迭代。',
        icon: 'tabler:code',
      },
      {
        title: 'SEO 基础建设',
        description: '交付标题结构、元信息、站点地图、语义化内容和基础性能优化，为搜索收录和自然流量打好基础。',
        icon: 'tabler:rocket',
      },
      {
        title: '转化路径设计',
        description: '围绕咨询、留资、下载资料、预约演示等目标设计按钮、表单和内容节奏，减少用户决策阻力。',
        icon: 'tabler:route',
      },
      {
        title: '上线与维护支持',
        description: '支持部署、域名配置、数据统计、内容更新和后续页面扩展，让官网不是一次性交付后就停摆。',
        icon: 'tabler:lifebuoy',
      },
    ]}
  />

  <!-- Content Widget **************** -->

  <Content
    isReversed
    tagline="我们的优势"
    title="懂业务、懂设计，也懂前端工程"
    items={[
      {
        title: '先定义业务目标',
        description: '在设计前先明确目标客户、核心转化动作和内容优先级，避免官网变成只展示公司简介的静态画册。',
      },
      {
        title: '设计服务于信任建立',
        description: '通过清晰版式、案例证明、专业内容和统一视觉，让访客更快判断你的实力与匹配度。',
      },
      {
        title: '代码交付可维护',
        description: '使用模块化组件和规范化样式组织，方便后续新增页面、调整内容和接入数据统计。',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1519389950473-47ba0277781c?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80',
      alt: '企业官网项目协作场景',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">从一次改版，变成长期资产</h3>
      我们关注的不只是首页好不好看，更关注访客能否理解、信任并采取下一步行动。
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    isAfterContent
    items={[
      {
        title: '定制首页',
        description: `围绕品牌定位、核心服务、客户案例和转化入口设计首页，让首屏就能传达你的专业价值。`,
      },
      {
        title: '服务与解决方案页面',
        description: '把复杂的产品、服务或行业方案拆解成易读的页面结构，帮助客户快速找到与自己相关的信息。',
      },
      {
        title: '案例与信任背书',
        description: '通过客户案例、项目成果、合作品牌、资质认证和团队信息，建立更完整的信任链路。',
      },
      {
        title: '响应式与访问体验',
        description: '适配桌面端、平板和手机端，优化图片、排版、导航和表单体验，让不同设备访问都顺畅。',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1600132806370-bf17e65e942f?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2194&q=80',
      alt: '企业官网页面规划',
    }}
  >
    <Fragment slot="content">交付的不只是页面，而是一套可以持续迭代的官网内容体系。</Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    isReversed
    isAfterContent
    items={[
      {
        title: '更清晰的品牌表达',
        description: '让潜在客户在短时间内理解你的业务边界、核心优势和服务流程，减少沟通成本。',
      },
      {
        title: '更稳定的自然流量基础',
        description: '通过合理的页面结构、语义化内容和性能优化，为后续 SEO 和内容运营提供基础。',
      },
      {
        title: '更高的线索转化效率',
        description: '在关键位置设置咨询入口、表单和行动引导，把访问流量转化成更明确的业务线索。',
      },
      {
        title: '更低的后续维护成本',
        description: `模块化页面结构便于后续扩展服务、发布文章、增加案例或配合市场活动快速新增落地页。`,
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1611462985358-60d3498e0364?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80',
      alt: '企业官网增长价值',
    }}
  >
    <Fragment slot="content">让官网既能代表企业形象，也能承担获客和转化任务。</Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Steps Widget ****************** -->

  <Steps
    title="从需求梳理到正式上线，我们按清晰流程推进每个官网项目。"
    items={[
      {
        title: '第 1 步：<span class="font-medium">业务访谈与诊断</span>',
        description: '了解你的目标客户、业务模式、现有官网问题和转化目标，明确项目范围、页面清单和优先级。',
        icon: 'tabler:messages',
      },
      {
        title: '第 2 步：<span class="font-medium">内容策划与视觉设计</span>',
        description: '梳理页面信息架构、撰写核心文案方向，并完成符合品牌调性的视觉设计稿。',
        icon: 'tabler:layout-dashboard',
      },
      {
        title: '第 3 步：<span class="font-medium">开发联调与上线</span>',
        description: '完成响应式开发、性能优化、SEO 基础配置、表单或统计接入，并协助部署到正式环境。',
        icon: 'tabler:device-desktop-code',
      },
      {
        title: '持续优化',
        icon: 'tabler:check',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1616198814651-e71f960c3180?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=987&q=80',
      alt: '企业官网项目交付流程',
    }}
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="企业官网常见交付模块"
    subtitle="根据行业、客单价和销售周期组合页面模块，让网站从展示型升级为业务型。"
    tagline="交付内容"
    items={[
      {
        title: '导航与首屏',
        description: '清晰呈现品牌定位、核心价值和主要行动入口，让访客进入页面后迅速判断是否继续了解。',
        icon: 'flat-color-icons:template',
      },
      {
        title: '服务介绍',
        description: '把服务内容、适用客户、交付成果和合作方式讲清楚，减少客户反复询问基础问题。',
        icon: 'flat-color-icons:gallery',
      },
      {
        title: '解决方案',
        description: '面向不同行业或场景组织内容，让潜在客户看到与自身业务直接相关的方案。',
        icon: 'flat-color-icons:approval',
      },
      {
        title: '案例展示',
        description: '用项目背景、解决思路和结果数据呈现真实能力，比单纯罗列服务更容易建立信任。',
        icon: 'flat-color-icons:document',
      },
      {
        title: '行动转化',
        description: '设计咨询按钮、预约入口、资料下载或询价表单，让客户知道下一步该做什么。',
        icon: 'flat-color-icons:advertising',
      },
      {
        title: '套餐与报价',
        description: '按项目复杂度展示基础版、标准版或定制版范围，帮助客户形成合理预算预期。',
        icon: 'flat-color-icons:currency-exchange',
      },
      {
        title: '客户评价',
        description: '通过客户反馈、合作品牌和成果证明，加强企业背书和采购信心。',
        icon: 'flat-color-icons:voice-presentation',
      },
      {
        title: '联系表单',
        description: '根据销售流程收集姓名、公司、需求和预算等关键字段，提高后续跟进效率。',
        icon: 'flat-color-icons:business-contact',
      },
      {
        title: '页脚与合规',
        description: '统一放置导航、联系方式、备案信息、隐私政策和社交渠道，补齐官网基础信息。',
        icon: 'flat-color-icons:database',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Features2>

  <!-- FAQs Widget ******************* -->

  <FAQs
    title="常见问题"
    subtitle="在正式合作前，你可能会关心项目周期、交付范围、内容准备、SEO 和后续维护。"
    tagline="FAQ"
    classes={{ container: 'max-w-6xl' }}
    items={[
      {
        title: '官网定制项目通常需要多长时间？',
        description:
          '标准企业官网通常需要 3-6 周；如果包含复杂动效、多语言、内容迁移或大量案例页面，周期会根据范围延长。',
      },
      {
        title: '开始前我们需要准备哪些资料？',
        description:
          '建议准备公司介绍、服务资料、品牌视觉规范、案例素材、联系方式和现有官网数据。资料不完整也可以先启动，我们会在策划阶段协助梳理。',
      },
      {
        title: '你们只做设计，还是包含开发上线？',
        description: '我们可以提供从策划、设计、开发到部署上线的一站式交付，也可以根据你的团队情况只负责其中某个阶段。',
      },
      {
        title: '官网上线后可以由我们自己维护吗？',
        description:
          '可以。我们会按项目约定交付源码、部署说明和基础使用文档，也可以继续提供内容更新、页面扩展和技术维护服务。',
      },
      {
        title: '是否支持 SEO 和数据统计？',
        description:
          '支持。基础交付会包含标题、描述、语义结构、站点地图和性能优化，也可以接入统计工具，帮助你观察访问来源和转化表现。',
      },
      {
        title: '如何评估官网定制预算？',
        description:
          '预算主要取决于页面数量、设计复杂度、交互需求、内容整理深度和是否需要多语言或后台能力。我们会先确认范围，再给出清晰报价。',
      },
    ]}
  />
</Layout>
